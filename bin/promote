#!/bin/sh
set -eu

usage() {
  printf 'Usage: blogpromote <draft-name>\nExample: blogpromote my-new-piece\n'
}

if [ "${1:-}" = '--help' ] || [ "${1:-}" = '-h' ]; then
  usage
  exit 0
fi
if [ "$#" -ne 1 ]; then
  usage >&2
  exit 1
fi

draft_name=${1#_drafts/}
draft_name=${draft_name%.md}
case "$draft_name" in
  ''|-*|*[!a-z0-9-]*)
    printf 'Use a draft name with lowercase letters, numbers, and hyphens.\n' >&2
    exit 1
    ;;
esac

cd "$(dirname "$0")/.."
draft_file="_drafts/$draft_name.md"
post_file="_posts/$(date +%F)-$draft_name.md"

if [ ! -f "$draft_file" ]; then
  printf 'Draft not found: %s\n' "$draft_file" >&2
  exit 1
fi
if [ -e "$post_file" ] || [ -L "$post_file" ]; then
  printf 'Post already exists; nothing moved: %s\n' "$post_file" >&2
  exit 1
fi

mkdir -p _posts
mv -n "$draft_file" "$post_file"
if [ -e "$draft_file" ] || [ -L "$draft_file" ]; then
  printf 'Draft was not moved; check the destination: %s\n' "$post_file" >&2
  exit 1
fi
printf 'Promoted to %s\n' "$post_file"
printf 'Preview: blognodrafts\n'
