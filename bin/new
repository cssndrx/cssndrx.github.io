#!/usr/bin/env python3
"""Create a local Markdown draft from a slug."""

import argparse
import json
from pathlib import Path
import re


def main():
    parser = argparse.ArgumentParser(
        prog="blognew", description="Create a draft from a slug with a Markdown template."
    )
    parser.add_argument("slug", help="Draft filename without .md, for example my-new-piece")
    args = parser.parse_args()
    slug = args.slug
    if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", slug):
        parser.error("Use a slug with lowercase letters, numbers, and single hyphens, such as my-new-piece.")
    title = slug.replace("-", " ").capitalize()

    root = Path(__file__).resolve().parent.parent
    relative_path = Path("_drafts") / (slug + ".md")
    draft = root / relative_path
    content = f'''---
title: {json.dumps(title, ensure_ascii=False)}
---

Start writing here. The opening paragraph also becomes the homepage excerpt.

## A heading

A paragraph with **bold**, *italic*, and [a link](https://example.com).

![Describe the image](/images/landscape.jpeg)
'''
    try:
        draft.parent.mkdir(parents=True, exist_ok=True)
        with draft.open("x", encoding="utf-8") as output:
            output.write(content)
    except FileExistsError:
        parser.exit(1, f"Draft already exists; nothing changed: {relative_path}\n")
    except OSError as error:
        parser.exit(1, f"Could not create the draft: {error}\n")

    print(f"Created {relative_path}")
    print(f"Preview: blogwithdrafts\nPromote: blogpromote {slug}")


if __name__ == "__main__":
    main()
